# Copy to .env and fill in. The API is served by this same app under /api.
DATABASE_URL="postgresql://geo3d:geo3d@localhost:5432/geo3d?schema=public"

# Auth.js: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Public base URL (used in tracking links sent to customers)
APP_URL=http://localhost:3000

# Payment-proof storage: "local" (disk) or "s3" (S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=auto
# S3_BUCKET=geo3d-private
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Email (Resend). Without a key, emails are logged to the console.
# RESEND_API_KEY=
# EMAIL_FROM="Geo3D <orders@example.com>"
# Optional: workshop address that gets an alert when a payment screenshot needs review
# STAFF_NOTIFY_EMAIL=you@example.com

# First admin user created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@geo3d.local
SEED_ADMIN_PASSWORD=ChangeMe123!
